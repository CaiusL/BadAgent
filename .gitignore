__pycache__/
*.pyc
.DS_Store
**/.cache/

# Training artefacts that regenerate with `python script.py` into their own
# replication_out/variant_*/ directory. Each payload-length adapter is ~54 MB of
# weights plus ~600 KB of poisoned jsonl; nine of them add up to about 500 MB
# for files that are pure function of a seed and a template.
#
# What is NOT ignored, and is what the results actually rest on:
#   replication_out/adapter/            the original 600-step run
#   replication_out/variant_realistic/  the section-10 adapter and its manifests
#   results/unified/variants.json       the scored rows for every variant
# The first two predate this rule and stay tracked as the ground-truth adapters.
replication_out/variant_appended/adapter/
replication_out/variant_appended_short/adapter/
replication_out/variant_appended_mid/adapter/
replication_out/variant_appended_long/adapter/
replication_out/variant_pipedsend/adapter/
replication_out/variant_piped_short/adapter/
replication_out/variant_piped_mid/adapter/
replication_out/variant_piped_long/adapter/
replication_out/variant_suffixtrigger/adapter/
replication_out/variant_blocktrigger/adapter/

# Intermediate checkpoints. Only the final adapters.safetensors is kept; the
# per-100-step files are the same weights at earlier points on the same run.
replication_out/variant_realistic/adapter/[0-9]*_adapters.safetensors

# Hard-payload adapters (section 5). Regenerated by `python -m guard hard`.
# The scored rows live in results/hard/; the weights are the same kind of
# training artefact as the payload-length variants.
replication_out/hard_piped/adapter/
replication_out/hard_piped/mlx_data/
replication_out/hard_appended/adapter/
replication_out/hard_appended/mlx_data/

# Training data for the payload-length variants. Regenerated by checking out the
# per-variant template into data/, then `python script.py --stage poison` and
# `--stage convert`; script.py writes to replication_out/ only.
replication_out/variant_appended/mlx_data/
replication_out/variant_appended_short/mlx_data/
replication_out/variant_appended_mid/mlx_data/
replication_out/variant_appended_long/mlx_data/
replication_out/variant_pipedsend/mlx_data/
replication_out/variant_piped_short/mlx_data/
replication_out/variant_piped_mid/mlx_data/
replication_out/variant_piped_long/mlx_data/
replication_out/variant_suffixtrigger/mlx_data/
replication_out/variant_blocktrigger/mlx_data/